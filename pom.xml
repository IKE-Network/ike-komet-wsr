<?xml version="1.0" encoding="UTF-8"?>
<!--
  ike-komet-wsr

  Inherits from ike-parent to get plugin version management for
  ike-maven-plugin and ike-workspace-maven-plugin automatically.

  Subprojects are declared unconditionally at top level.
  ike-workspace-extension (registered in .mvn/extensions.xml) prunes
  entries whose directory is missing from disk before Maven's model
  validator gets to them — so a fresh clone bootstraps via
  ws:scaffold-init without manual edits. See IKE-Network/ike-issues#460.

  Usage:
    mvn clean install                        # All cloned repos
    mvn ws:scaffold-init                     # Clone all repos
    mvn ws:overview                          # Workspace overview
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
                             https://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>166</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.komet</groupId>
    <artifactId>ike-komet-wsr</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ike-komet-wsr</name>
    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <!-- This working set's members are ikmdev repositories that
             have tagged their releases bare (1.127.1) for their whole
             history. The release cycle both writes and reads tags in
             this style, so those repositories keep one convention and
             detection sees their real release history. -->
        <ike.release.tagStyle>BARE</ike.release.tagStyle>
    </properties>

    <!-- Locally declared so the cascade's coordinate-to-repository
         lookup resolves a real repo URL, not the artifactId-appended
         path Maven would otherwise inherit from ike-parent (and in
         turn ike-base-parent). See IKE-Network/ike-issues#496. -->
    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-komet-wsr.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-komet-wsr.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-komet-wsr</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <!-- Explicit <site> URL — inheriting ike-parent outside the
             ike-platform reactor pulls in a site URL template tuned
             for in-reactor modules (https://ike.network/ike-platform/...).
             ike-issues#380 realigned that template; ike-issues#383 added
             an enforcer that fails the build when an external consumer
             leaves the in-reactor URL inherited. See ike-parent/CLAUDE.md
             ("Inheriting projects MUST declare their own
             <distributionManagement><site>"). -->
        <site>
            <id>ike-site</id>
            <url>https://ike.network/${project.artifactId}/</url>
        </site>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <inherited>true</inherited>
                <configuration>
                    <release>26</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <!-- version from ike-parent pluginManagement -->
            </plugin>
            <plugin>
                <groupId>network.ike.platform</groupId>
                <artifactId>ike-workspace-maven-plugin</artifactId>
                <!-- version from ike-parent pluginManagement -->
            </plugin>
        </plugins>
    </build>

    <!-- Subprojects are added by ws:add -->
    <subprojects>
        <subproject>ike-commonmark-attributes</subproject>
        <subproject>komet-claude-plugin</subproject>
        <subproject>komet-example-rules-plugin</subproject>
        <subproject>complex-clause-plugin</subproject>
        <subproject>tinkar-schema</subproject>
        <subproject>ike-knowledge-provider</subproject>
        <subproject>tinkar-service</subproject>
        <subproject>komet-grpc-plugin</subproject>
        <subproject>komet-bom</subproject>
        <subproject>tinkar-core</subproject>
        <subproject>tinkar-composer</subproject>
        <subproject>rocks-kb</subproject>
        <subproject>komet</subproject>
        <subproject>komet-desktop</subproject>
    </subprojects>

</project>
